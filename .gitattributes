# Store text files with LF in the repo and check them out with LF on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.pdf binary
