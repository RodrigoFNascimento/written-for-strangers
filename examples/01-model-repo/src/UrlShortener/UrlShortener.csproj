<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Every public type and member needs an XML doc comment: CS1591 is an error here
         because warnings are errors. Missing docs fail the build, not the review. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

</Project>
