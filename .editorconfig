root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# .NET files: dotnet new writes CRLF with a BOM, and dotnet format enforces these two keys,
# so leave them to .gitattributes (the repo stores LF either way).
[*.{cs,csproj,props,targets,slnx}]
indent_size = 4
end_of_line = unset
charset = unset
